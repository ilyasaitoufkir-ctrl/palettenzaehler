{
  "name": "palettenzaehler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile PWA fuer die Paletteninventur mit KI gestuetzter Mengenerkennung",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@zxing/library": "^0.21.3",
    "exceljs": "^4.4.0",
    "firebase": "11.10.0",
    "firebase-admin": "13.10.0",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "25.0.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
