# ── Frontend (öffentlich, landen im Bundle) ─────────────────────────
# Aus Firebase Konsole > Projekteinstellungen > Deine Apps > Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true erzwingt den Demo Modus (lokale Beispieldaten, simulierte KI), auch wenn Firebase gesetzt ist.
# Ohne Firebase Werte ist der Demo Modus automatisch aktiv.
VITE_DEMO_MODE=false

# true: echte KI Erkennung OHNE Firebase. Daten bleiben auf dem Gerät, Anmeldung mit Zugangscode.
# Dafür auf dem Server ANTHROPIC_API_KEY und APP_ZUGANGSCODE setzen.
VITE_KI_ECHT=false

# ── Server (geheim, NUR in Vercel Environment Variables eintragen) ──
# Anthropic Konsole > API Keys
ANTHROPIC_API_KEY=
# Modell mit Bildverarbeitung, z. B. claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Firebase Konsole > Projekteinstellungen > Dienstkonten > Neuen privaten Schlüssel generieren
# Den kompletten JSON Inhalt in EINER Zeile eintragen
FIREBASE_SERVICE_ACCOUNT_JSON=
# Nur für VITE_KI_ECHT=true: gemeinsamer Zugangscode, mindestens 8 Zeichen
APP_ZUGANGSCODE=
